local function onSeated(seat)
    state.currentCar = getCarFromSeat(seat)
    state.flipState = nil
    state.currentBody = nil
    if state.currentCar then
        status.Text = state.currentCar.Name
        status.TextColor3 = COL_GREEN
        local chassis = getChassisPart(state.currentCar)
        state.currentBody = chassis
        info.Text = chassis and ("chassis  " .. chassis.Name) or "chassis not found"
    else
        status.Text = "Seated, no car found"
        status.TextColor3 = Color3.fromRGB(230, 190, 90)
        info.Text = ""
    end
end

local function onUnseated()
    state.currentCar = nil
    state.currentBody = nil
    state.flipState = nil
    status.Text = "Waiting for vehicle..."
    status.TextColor3 = COL_TEXT_DIM
    info.Text = ""
    if _G.__NZFlyStop then _G.__NZFlyStop() end
end

local function bindCharacter(char)
    local humanoid = char:WaitForChild("Humanoid", 5)
    if not humanoid then return end
    humanoid.Seated:Connect(function(isSeated, seat)
        if isSeated then onSeated(seat) else onUnseated() end
    end)
    if humanoid.SeatPart then onSeated(humanoid.SeatPart) end
end

if player.Character then bindCharacter(player.Character) end
player.CharacterAdded:Connect(bindCharacter)

--------------------------------------------------------------------
-- THRUST LOOP
--------------------------------------------------------------------
local activeForce  = nil
local activeAttach = nil
local forceConn    = nil
local boostEnabled = false
local currentThrust = DEFAULT_THRUST

local function stopThrust()
    if forceConn then forceConn:Disconnect() forceConn = nil end
    if activeForce then pcall(function() activeForce:Destroy() end) activeForce = nil end
    if activeAttach then pcall(function() activeAttach:Destroy() end) activeAttach = nil end
end

local function ensureForceObjects(chassis)
    if activeForce and activeForce.Parent == chassis then return end
    if activeForce then pcall(function() activeForce:Destroy() end) end
    if activeAttach then pcall(function() activeAttach:Destroy() end) end
    activeAttach = Instance.new("Attachment")
    activeAttach.Name = "_NZAttach"
    activeAttach.Parent = chassis
    activeForce = Instance.new("VectorForce")
    activeForce.Name = "_NZForce"
    activeForce.Attachment0 = activeAttach
    activeForce.RelativeTo = Enum.ActuatorRelativeTo.World
    activeForce.ApplyAtCenterOfMass = true
    activeForce.Force = Vector3.zero
    activeForce.Parent = chassis
end

local function startLoop()
    if forceConn then forceConn:Disconnect() forceConn = nil end
    forceConn = RunService.Heartbeat:Connect(function()
        if not boostEnabled then return end
        if _G.__NZFlyActive then return end
        if not state.currentCar or not state.currentCar.Parent then return end

        local chassis = getChassisPart(state.currentCar)
        if not chassis then return end
        ensureForceObjects(chassis)

        if not state.forwardHeld or state.backHeld then
            if activeForce then activeForce.Force = Vector3.zero end
            return
        end

        local facing = chassis.CFrame.LookVector
        local flat = Vector3.new(facing.X, 0, facing.Z)
        if flat.Magnitude < 0.01 then
            activeForce.Force = Vector3.zero
            return
        end

        if state.flipState == nil then
            local tVal = findThrottleValue()
            if tVal then
                local t = tVal.Value
                local flatT = Vector3.new(t.X, 0, t.Z)
                if flatT.Magnitude > 0.01 then
                    local worldDir = (chassis.CFrame:VectorToWorldSpace(flatT)).Unit
                    state.flipState = worldDir:Dot(flat.Unit) < 0
                end
            end
        end
        if state.flipState == nil then
            local v = chassis.AssemblyLinearVelocity
            local vFlat = Vector3.new(v.X, 0, v.Z)
            if vFlat.Magnitude > 5 then
                state.flipState = vFlat.Unit:Dot(flat.Unit) < 0
            end
        end
        if state.flipState == true then flat = -flat end
        flat = flat.Unit

        local speed = chassis.AssemblyLinearVelocity.Magnitude
        local capFactor = 1
        if speed > MAX_SPEED_SOFT then
            capFactor = math.clamp(1 - (speed - MAX_SPEED_SOFT) / 100, 0, 1)
        end
        local strength = currentThrust * capFactor
        if speed < MIN_SPEED then strength = currentThrust * 0.5 end
        activeForce.Force = flat * strength
    end)
end

local function setBoost(stateOn)
    boostEnabled = stateOn
    if stateOn then
        enableBtn.Text = "Boost Online"
        TweenService:Create(enableBtn, TweenInfo.new(0.18), {
            BackgroundColor3 = COL_GREEN, TextColor3 = Color3.fromRGB(255,255,255)
        }):Play()
        TweenService:Create(enableStroke, TweenInfo.new(0.18), {Color = COL_GREEN}):Play()
        startLoop()
    else
        enableBtn.Text = "Boost Offline"
        TweenService:Create(enableBtn, TweenInfo.new(0.18), {
            BackgroundColor3 = COL_BG_ALT, TextColor3 = COL_TEXT_DIM
        }):Play()
        TweenService:Create(enableStroke, TweenInfo.new(0.18), {Color = COL_BORDER}):Play()
        stopThrust()
        updateInputLabel()
    end
end

enableBtn.MouseButton1Click:Connect(function()
    if not state.currentCar then
        status.Text = "Sit in a car first"
        status.TextColor3 = COL_RED
        return
    end
    setBoost(not boostEnabled)
end)

local function flashOk(boxStrokeObj)
    if not boxStrokeObj then return end
    TweenService:Create(boxStrokeObj, TweenInfo.new(0.12), {Color = COL_GREEN}):Play()
    task.delay(0.25, function()
        if boxStrokeObj and boxStrokeObj.Parent then
            TweenService:Create(boxStrokeObj, TweenInfo.new(0.35), {Color = COL_BORDER}):Play()
        end
    end)
end

local function applyThrust()
    local n = tonumber(thrustBox.Text)
    if not n or n < 0 then
        thrustBox.TextColor3 = COL_RED
        TweenService:Create(thrustBox, TweenInfo.new(0.4), {TextColor3 = COL_TEXT}):Play()
        return
    end
    currentThrust = math.min(n, THRUST_CEILING)
    thrustBox.Text = tostring(currentThrust)
    flashOk(thrustBoxStroke)
end

thrustApply.MouseButton1Click:Connect(applyThrust)
thrustBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then applyThrust() end
end)

