local BOOST_CLICK_COOLDOWN = 0.2
local lastBoostClick = 0
local lastWheelieClick = 0
local lastBackClick = 0

local function refreshBoostLoop()
    if boostEnabled or backEnabled then
        startLoop()
    else
        stopThrust()
    end
    updateInputLabel()
end

local function setBoost(stateOn)
    stateOn = stateOn and true or false
    if boostEnabled == stateOn then return end
    boostEnabled = stateOn

    if boostEnabled then
        enableBtn.Text = "Boost Online"
        TweenService:Create(enableBtn, TweenInfo.new(0.18), {
            BackgroundColor3 = COL_GREEN, TextColor3 = Color3.fromRGB(255,255,255)
        }):Play()
        TweenService:Create(enableStroke, TweenInfo.new(0.18), {Color = COL_GREEN}):Play()
    else
        enableBtn.Text = "Boost Offline"
        TweenService:Create(enableBtn, TweenInfo.new(0.18), {
            BackgroundColor3 = COL_BG_ALT, TextColor3 = COL_TEXT_DIM
        }):Play()
        TweenService:Create(enableStroke, TweenInfo.new(0.18), {Color = COL_BORDER}):Play()
    end
    refreshBoostLoop()
end

local function setBackThrust(stateOn)
    stateOn = stateOn and true or false
    if backEnabled == stateOn then return end
    backEnabled = stateOn

    if backEnabled then
        backEnableBtn.Text = "BackThrust: On"
        TweenService:Create(backEnableBtn, TweenInfo.new(0.18), {
            BackgroundColor3 = COL_GREEN, TextColor3 = Color3.fromRGB(255,255,255)
        }):Play()
        TweenService:Create(backEnableStroke, TweenInfo.new(0.18), {Color = COL_GREEN}):Play()
    else
        backEnableBtn.Text = "BackThrust: Off"
        TweenService:Create(backEnableBtn, TweenInfo.new(0.18), {
            BackgroundColor3 = COL_BG_ALT, TextColor3 = COL_TEXT_DIM
        }):Play()
        TweenService:Create(backEnableStroke, TweenInfo.new(0.18), {Color = COL_BORDER}):Play()
    end
    refreshBoostLoop()
end

local function setWheelie(stateOn)
    stateOn = stateOn and true or false
    if wheelieEnabled == stateOn then return end
    wheelieEnabled = stateOn

    if wheelieEnabled then
        wheelieBtn.Text = "Wheelie: On"
        TweenService:Create(wheelieBtn, TweenInfo.new(0.18), {
            BackgroundColor3 = COL_GREEN, TextColor3 = Color3.fromRGB(255,255,255)
        }):Play()
    else
        wheelieBtn.Text = "Wheelie: Off"
        TweenService:Create(wheelieBtn, TweenInfo.new(0.18), {
            BackgroundColor3 = COL_BG_ALT, TextColor3 = COL_TEXT_DIM
        }):Play()
        wheelieAmount = 0
        if wheelieForceL then wheelieForceL.Force = Vector3.zero end
        if wheelieForceR then wheelieForceR.Force = Vector3.zero end
    end
end

