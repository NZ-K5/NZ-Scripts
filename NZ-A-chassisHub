--------------------------------------------------------------------
local function setEnabled(state)
    enabled = state
    if enabled then
        enableBtn.Text = "Boost Online"
        TweenService:Create(enableBtn, TweenInfo.new(0.18), {
            BackgroundColor3 = COL_GREEN,
            TextColor3 = Color3.fromRGB(255,255,255)
        }):Play()
        TweenService:Create(enableStroke, TweenInfo.new(0.18), {
            Color = COL_GREEN
        }):Play()
        startLoop()
    else
        enableBtn.Text = "Boost Offline"
        TweenService:Create(enableBtn, TweenInfo.new(0.18), {
            BackgroundColor3 = COL_BG_ALT,
            TextColor3 = COL_TEXT_DIM
        }):Play()
        TweenService:Create(enableStroke, TweenInfo.new(0.18), {
            Color = COL_BORDER
        }):Play()
        stopThrust()
        updateInputLabel()
    end
end

