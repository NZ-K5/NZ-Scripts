    local delBtn = Instance.new("TextButton")
    delBtn.Size = UDim2.new(0, 24, 0, 24)
    delBtn.Position = UDim2.new(1, -60, 0.5, -12)
    delBtn.BackgroundColor3 = Color3.fromRGB(38, 39, 48)
