-- WHEELIE STATE
--------------------------------------------------------------------
local wheelieEnabled = false
local wheelieAmount  = 0
local wheelieForceCurrent = WHEELIE_FORCE_DEFAULT
local wheelieAttachL = nil
local wheelieAttachR = nil
local wheelieForceL  = nil
local wheelieForceR  = nil
local wheelieCachedCar = nil
local wheelieLastFind  = 0

local function destroyWheelieObjects()
    if wheelieForceL then pcall(function() wheelieForceL:Destroy() end) wheelieForceL = nil end
    if wheelieForceR then pcall(function() wheelieForceR:Destroy() end) wheelieForceR = nil end
    if wheelieAttachL then pcall(function() wheelieAttachL:Destroy() end) wheelieAttachL = nil end
    if wheelieAttachR then pcall(function() wheelieAttachR:Destroy() end) wheelieAttachR = nil end
    wheelieCachedCar = nil
end

local function ensureWheelieObjects(chassis)
    if not wheelieEnabled then return end
    local car = state.currentCar
    if not car then return end

    if wheelieForceL and wheelieForceR
        and wheelieForceL.Parent and wheelieForceR.Parent
        and wheelieForceL.Parent:IsDescendantOf(car)
        and wheelieForceR.Parent:IsDescendantOf(car) then
        return
    end

    local now = os.clock()
    if wheelieCachedCar == car and (now - wheelieLastFind) < 1 then return end
    wheelieLastFind = now
    wheelieCachedCar = car

    destroyWheelieObjects()

    local fl, fr = getFrontWheels(car)
    local targetL = fl or chassis
    local targetR = fr or chassis

    wheelieAttachL = Instance.new("Attachment")
    wheelieAttachL.Name = "_NZWheelieAttachL"
    if fl then
        wheelieAttachL.Position = Vector3.zero
    else
        wheelieAttachL.Position = Vector3.new(-0.5 * chassis.Size.X, 0, -0.5 * chassis.Size.Z)
    end
    wheelieAttachL.Parent = targetL

    wheelieForceL = Instance.new("VectorForce")
    wheelieForceL.Name = "_NZWheelieForceL"
    wheelieForceL.Attachment0 = wheelieAttachL
    wheelieForceL.RelativeTo = Enum.ActuatorRelativeTo.World
    wheelieForceL.ApplyAtCenterOfMass = false
    wheelieForceL.Force = Vector3.zero
    wheelieForceL.Parent = targetL

    wheelieAttachR = Instance.new("Attachment")
    wheelieAttachR.Name = "_NZWheelieAttachR"
    if fr then
        wheelieAttachR.Position = Vector3.zero
    else
        wheelieAttachR.Position = Vector3.new(0.5 * chassis.Size.X, 0, -0.5 * chassis.Size.Z)
    end
    wheelieAttachR.Parent = targetR

    wheelieForceR = Instance.new("VectorForce")
    wheelieForceR.Name = "_NZWheelieForceR"
    wheelieForceR.Attachment0 = wheelieAttachR
    wheelieForceR.RelativeTo = Enum.ActuatorRelativeTo.World
    wheelieForceR.ApplyAtCenterOfMass = false
    wheelieForceR.Force = Vector3.zero
    wheelieForceR.Parent = targetR
end

--------------------------------------------------------------------
-- THRUST + BACKTHRUST + WHEELIE LOOP
--------------------------------------------------------------------
local activeForce  = nil
local activeAttach = nil
local forceConn    = nil
local boostEnabled = false
local backEnabled  = false
local currentThrust = DEFAULT_THRUST
local currentBackThrust = DEFAULT_BACK_THRUST
local lastChassis  = nil

local function stopThrust()
    if forceConn then forceConn:Disconnect() forceConn = nil end
    if activeForce then pcall(function() activeForce:Destroy() end) activeForce = nil end
    if activeAttach then pcall(function() activeAttach:Destroy() end) activeAttach = nil end
    destroyWheelieObjects()
    lastChassis = nil
    wheelieAmount = 0
end

local function ensureForceObjects(chassis)
    if activeForce and activeForce.Parent == chassis then return end
    if activeForce then pcall(function() activeForce:Destroy() end) end
    if activeAttach then pcall(function() activeAttach:Destroy() end) end
    activeAttach = Instance.new("Attachment")
    activeAttach.Name = "_NZAttach"
    activeAttach.Parent = chassis
    activeForce = Instance.new("VectorForce")
    activeForce.Name = "_NZForce"
    activeForce.Attachment0 = activeAttach
    activeForce.RelativeTo = Enum.ActuatorRelativeTo.World
    activeForce.ApplyAtCenterOfMass = true
    activeForce.Force = Vector3.zero
    activeForce.Parent = chassis
end

local function startLoop()
    if forceConn then return end
    forceConn = RunService.Heartbeat:Connect(function(dt)
        if not boostEnabled and not backEnabled then return end
        if _G.__NZFlyActive then return end
        if not state.currentCar or not state.currentCar.Parent then return end

        local chassis = lastChassis
        if not chassis or not chassis.Parent or not chassis:IsDescendantOf(state.currentCar) then
            chassis = getChassisPart(state.currentCar)
            lastChassis = chassis
        end
        if not chassis then return end
        ensureForceObjects(chassis)

        local fwd = state.forwardHeld or state.keyForward
        local bck = state.backHeld or state.keyBack

        if boostEnabled and fwd and not bck then
            local facing = chassis.CFrame.LookVector
            local flat = Vector3.new(facing.X, 0, facing.Z)
            if flat.Magnitude >= 0.01 then
                if state.flipState == nil then
                    local tVal = findThrottleValue()
                    if tVal then
                        local t = tVal.Value
                        local flatT = Vector3.new(t.X, 0, t.Z)
                        if flatT.Magnitude > 0.01 then
                            local worldDir = (chassis.CFrame:VectorToWorldSpace(flatT)).Unit
                            state.flipState = worldDir:Dot(flat.Unit) < 0
                        end
                    end
                end
                if state.flipState == nil then
                    local v = chassis.AssemblyLinearVelocity
                    local vFlat = Vector3.new(v.X, 0, v.Z)
                    if vFlat.Magnitude > 5 then
                        state.flipState = vFlat.Unit:Dot(flat.Unit) < 0
                    end
                end
                if state.flipState == true then flat = -flat end
                flat = flat.Unit

                local speed = chassis.AssemblyLinearVelocity.Magnitude
                local capFactor = 1
                if speed > MAX_SPEED_SOFT then
                    capFactor = math.clamp(1 - (speed - MAX_SPEED_SOFT) / 100, 0, 1)
                end
                local strength = currentThrust * capFactor
                if speed < MIN_SPEED then strength = currentThrust * 0.5 end
                activeForce.Force = flat * strength
            end
        elseif backEnabled and bck and not fwd then
            local facing = chassis.CFrame.LookVector
            local flat = Vector3.new(facing.X, 0, facing.Z)
            if flat.Magnitude >= 0.01 then
                flat = flat.Unit
                if state.flipState == true then flat = -flat end

                local speed = chassis.AssemblyLinearVelocity.Magnitude
                local capFactor = 1
                if speed > MAX_SPEED_SOFT then
                    capFactor = math.clamp(1 - (speed - MAX_SPEED_SOFT) / 100, 0, 1)
                end
                local strength = currentBackThrust * capFactor
                if speed < MIN_SPEED then strength = currentBackThrust * 0.5 end
                activeForce.Force = -flat * strength
            end
        else
            if activeForce then activeForce.Force = Vector3.zero end
        end

        if wheelieEnabled then
            ensureWheelieObjects(chassis)

            local speed = chassis.AssemblyLinearVelocity.Magnitude
            local movingFast = speed >= WHEELIE_MIN_SPEED
            local pitching = fwd and not bck and movingFast

            if pitching then
                wheelieAmount = math.min(1, wheelieAmount + dt / math.max(wheelieRampUp, 0.01))
            else
                wheelieAmount = math.max(0, wheelieAmount - dt * WHEELIE_DROP_SPEED)
            end

            local look = chassis.CFrame.LookVector
            local flatLook = Vector3.new(look.X, 0, look.Z)
            local pitchDeg = 0
            if flatLook.Magnitude > 0.001 then
                pitchDeg = math.deg(math.acos(math.clamp(look:Dot(flatLook.Unit), -1, 1)))
            end
            if pitchDeg > WHEELIE_MAX_PITCH then
                wheelieAmount = 0
            end

            if wheelieForceL and wheelieForceL.Parent
                and wheelieForceR and wheelieForceR.Parent then
                local mass = chassis:GetMass()
                local massScale = math.clamp(mass / 1000, 0.3, 20)
                local strength = wheelieForceCurrent * wheelieAmount * massScale
                local upVec = Vector3.new(0, strength, 0)
                wheelieForceL.Force = upVec
                wheelieForceR.Force = upVec
            end
        else
            if wheelieForceL then wheelieForceL.Force = Vector3.zero end
            if wheelieForceR then wheelieForceR.Force = Vector3.zero end
            wheelieAmount = 0
        end
    end)
end

