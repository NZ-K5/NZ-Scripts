-- FLY GUI (built on demand)
--------------------------------------------------------------------
local function openFlyGui()
    if _G.__NZFly and _G.__NZFly.Parent then
        _G.__NZFly.Enabled = true
        return
    end

    local flyGui = Instance.new("ScreenGui")
    flyGui.Name = "NZFly"
    flyGui.ResetOnSpawn = false
    flyGui.IgnoreGuiInset = true
    flyGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    local okF = pcall(function() flyGui.Parent = CoreGui end)
    if not okF then flyGui.Parent = player:WaitForChild("PlayerGui") end
    _G.__NZFly = flyGui

    local flyMain = Instance.new("Frame")
    flyMain.Name = "Window"
    flyMain.Size = UDim2.new(0, 300, 0, 0)
    flyMain.Position = UDim2.new(0.5, 60, 0.45, -130)
    flyMain.BackgroundColor3 = COL_BG
    flyMain.BorderSizePixel = 0
    flyMain.ClipsDescendants = true
    flyMain.Parent = flyGui
    corner(flyMain, 12)
    stroke(flyMain, COL_BORDER, 1)

    local _, flyMinBtn = makeTitleBar(flyMain, "Car Fly", function()
        _G.__NZFly = nil
        stopFly()
    end)

    local flyBody = Instance.new("Frame")
    flyBody.Size = UDim2.new(1, 0, 1, -36)
    flyBody.Position = UDim2.new(0, 0, 0, 36)
    flyBody.BackgroundTransparency = 1
    flyBody.Parent = flyMain

    local flyStatus = Instance.new("TextLabel")
    flyStatus.Size = UDim2.new(1, -pad*2, 0, 16)
    flyStatus.Position = UDim2.new(0, pad, 0, 10)
    flyStatus.BackgroundTransparency = 1
    flyStatus.Text = "Not flying"
    flyStatus.TextColor3 = COL_TEXT_DIM
    flyStatus.Font = Enum.Font.Gotham
    flyStatus.TextSize = 11
    flyStatus.TextXAlignment = Enum.TextXAlignment.Left
    flyStatus.Parent = flyBody

    local flyHint = Instance.new("TextLabel")
    flyHint.Size = UDim2.new(1, -pad*2, 0, 14)
    flyHint.Position = UDim2.new(0, pad, 0, 28)
    flyHint.BackgroundTransparency = 1
    flyHint.Text = "Holds altitude · directional buttons"
    flyHint.TextColor3 = COL_TEXT_DIM
    flyHint.Font = Enum.Font.Gotham
    flyHint.TextSize = 9
    flyHint.TextXAlignment = Enum.TextXAlignment.Left
    flyHint.Parent = flyBody

    local dirPad = Instance.new("Frame")
    dirPad.Size = UDim2.new(1, -pad*2, 0, 130)
    dirPad.Position = UDim2.new(0, pad, 0, 48)
    dirPad.BackgroundTransparency = 1
    dirPad.Parent = flyBody

    local function makeDirBtn(text, x, y, w, h)
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(0, w, 0, h)
        b.Position = UDim2.new(0, x, 0, y)
        b.BackgroundColor3 = COL_BG_ALT
        b.Text = text
        b.TextColor3 = COL_TEXT
        b.Font = Enum.Font.GothamBold
        b.TextSize = 11
        b.BorderSizePixel = 0
        b.AutoButtonColor = false
        b.Parent = dirPad
        corner(b, 6)
        stroke(b, COL_BORDER, 1)
        b.MouseEnter:Connect(function()
            TweenService:Create(b, TweenInfo.new(0.12), {BackgroundColor3 = COL_ACCENT_HI}):Play()
        end)
        b.MouseLeave:Connect(function()
            TweenService:Create(b, TweenInfo.new(0.12), {BackgroundColor3 = COL_BG_ALT}):Play()
        end)
        return b
    end

    local btnW, btnH, gap = 88, 34, 6
    local btnFwd   = makeDirBtn("Forward", gap, 0, btnW, btnH)
    local btnBack  = makeDirBtn("Back",    gap + btnW + gap, 0, btnW, btnH)
    local btnUp    = makeDirBtn("Up",      gap, btnH + gap, btnW, btnH)
    local btnDown  = makeDirBtn("Down",    gap + btnW + gap, btnH + gap, btnW, btnH)
    local btnLeft  = makeDirBtn("Left",    gap, (btnH + gap) * 2, btnW, btnH)
    local btnRight = makeDirBtn("Right",   gap + btnW + gap, (btnH + gap) * 2, btnW, btnH)

    local function bindHold(btn, key)
        local function setKey(v)
            _G.__NZFlyHold[key] = v
            if v then
                TweenService:Create(btn, TweenInfo.new(0.1), {BackgroundColor3 = COL_GREEN}):Play()
            else
                TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = COL_BG_ALT}):Play()
            end
        end
        btn.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                setKey(true)
            end
        end)
        btn.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                setKey(false)
            end
        end)
        btn.MouseButton1Down:Connect(function() setKey(true) end)
        btn.MouseButton1Up:Connect(function() setKey(false) end)
    end

    bindHold(btnFwd, "forward")
    bindHold(btnBack, "back")
    bindHold(btnUp, "up")
    bindHold(btnDown, "down")
    bindHold(btnLeft, "left")
    bindHold(btnRight, "right")

    local flyToggle = Instance.new("TextButton")
    flyToggle.Size = UDim2.new(1, -pad*2, 0, 38)
    flyToggle.Position = UDim2.new(0, pad, 0, 190)
    flyToggle.BackgroundColor3 = COL_BG_ALT
    flyToggle.Text = "Enable Fly"
    flyToggle.TextColor3 = COL_TEXT_DIM
    flyToggle.Font = Enum.Font.GothamBold
    flyToggle.TextSize = 13
    flyToggle.BorderSizePixel = 0
    flyToggle.AutoButtonColor = false
    flyToggle.Parent = flyBody
    corner(flyToggle, 8)
    local flyToggleStroke = stroke(flyToggle, COL_BORDER, 1)

    local flyInfo = Instance.new("TextLabel")
    flyInfo.Size = UDim2.new(1, -pad*2, 0, 12)
    flyInfo.Position = UDim2.new(0, pad, 0, 236)
    flyInfo.BackgroundTransparency = 1
    flyInfo.Text = ""
    flyInfo.TextColor3 = COL_TEXT_DIM
    flyInfo.Font = Enum.Font.Gotham
    flyInfo.TextSize = 9
    flyInfo.TextXAlignment = Enum.TextXAlignment.Left
    flyInfo.Parent = flyBody

    local FLY_FULL_H = 256
    local FLY_MIN_H  = 36

    local function tweenFly(h)
        TweenService:Create(flyMain, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, flyMain.Size.X.Offset, 0, h),
        }):Play()
    end

    flyMain.Size = UDim2.new(0, 300, 0, FLY_MIN_H)
    if isMobile then
        flyMain.Size = UDim2.new(0, 260, 0, FLY_MIN_H)
        flyMain.Position = UDim2.new(0.5, -130, 0.35, 60)
    end
    task.spawn(function()
        task.wait(0.05)
        tweenFly(FLY_FULL_H)
    end)

    local flyMinimized = false
    flyMinBtn.MouseButton1Click:Connect(function()
        flyMinimized = not flyMinimized
        tweenFly(flyMinimized and FLY_MIN_H or FLY_FULL_H)
        flyMinBtn.Text = flyMinimized and "+" or "–"
        flyBody.Visible = not flyMinimized
    end)

    flyToggle.MouseButton1Click:Connect(function()
        if flyActive then
            stopFly()
            flyStatus.Text = "Not flying"
            flyStatus.TextColor3 = COL_TEXT_DIM
            flyToggle.Text = "Enable Fly"
            TweenService:Create(flyToggle, TweenInfo.new(0.18), {
                BackgroundColor3 = COL_BG_ALT, TextColor3 = COL_TEXT_DIM
            }):Play()
            TweenService:Create(flyToggleStroke, TweenInfo.new(0.18), {Color = COL_BORDER}):Play()
            flyInfo.Text = "restored original state"
        else
            if not state.currentCar then
                flyStatus.Text = "Sit in a car first"
                flyStatus.TextColor3 = COL_RED
                return
            end
            local chassis = getChassisPart(state.currentCar)
            if not chassis then
                flyStatus.Text = "No chassis found"
                flyStatus.TextColor3 = COL_RED
                return
            end
            startFly()
            flyStatus.Text = "Flying"
            flyStatus.TextColor3 = COL_GREEN
            flyToggle.Text = "Disable Fly"
            TweenService:Create(flyToggle, TweenInfo.new(0.18), {
                BackgroundColor3 = COL_GREEN, TextColor3 = Color3.fromRGB(255,255,255)
            }):Play()
            TweenService:Create(flyToggleStroke, TweenInfo.new(0.18), {Color = COL_GREEN}):Play()
            flyInfo.Text = "hovering · use direction buttons"
        end
    end)
end

flyOpenBtn.MouseButton1Click:Connect(openFlyGui)

