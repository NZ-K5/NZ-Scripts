-- Input state
--------------------------------------------------------------------
local forwardHeld = false
local backHeld    = false

local function updateInputLabel()
    if forwardHeld and backHeld then
        inputState.Text = "Input  forward + back"
        inputState.TextColor3 = Color3.fromRGB(230, 200, 120)
    elseif forwardHeld then
        inputState.Text = "Input  forward"
        inputState.TextColor3 = COL_GREEN
    elseif backHeld then
        inputState.Text = "Input  backward"
        inputState.TextColor3 = Color3.fromRGB(230, 150, 120)
    else
        inputState.Text = "Input  —"
        inputState.TextColor3 = COL_TEXT_DIM
    end
end

UserInputService.InputBegan:Connect(function(input, gp)
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    if input.KeyCode == KEY_FORWARD then forwardHeld = true; updateInputLabel()
    elseif input.KeyCode == KEY_BACK then backHeld = true; updateInputLabel() end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    if input.KeyCode == KEY_FORWARD then forwardHeld = false; updateInputLabel()
    elseif input.KeyCode == KEY_BACK then backHeld = false; updateInputLabel() end
end)

--------------------------------------------------------------------
-- Hook FullThrottle / FullBrake
--------------------------------------------------------------------
local hookedButtons = {}
local function hookButton(btn, setter)
    if not btn or hookedButtons[btn] then return end
    hookedButtons[btn] = true

    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            setter(true); updateInputLabel()
        end
    end)
    btn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            setter(false); updateInputLabel()
        end
    end)
    btn.MouseButton1Down:Connect(function() setter(true); updateInputLabel() end)
    btn.MouseButton1Up:Connect(function() setter(false); updateInputLabel() end)
end

local function findAndHookCarButtons()
    local pg = player:FindFirstChild("PlayerGui")
    if not pg then return end

    local aci = pg:FindFirstChild("A-Chassis Interface")
    if aci then
        local gauges = aci:FindFirstChild("Gauges")
        local guiFolder = gauges and gauges:FindFirstChild("GUI")
        if guiFolder then
            local ft = guiFolder:FindFirstChild("FullThrottle")
            local fb = guiFolder:FindFirstChild("FullBrake")
            if ft then hookButton(ft, function(v) forwardHeld = v end) end
            if fb then hookButton(fb, function(v) backHeld = v end) end
        end
    end

    for _, d in ipairs(pg:GetDescendants()) do
        if d:IsA("TextButton") or d:IsA("ImageButton") then
            if d.Name == "FullThrottle" then hookButton(d, function(v) forwardHeld = v end)
            elseif d.Name == "FullBrake" then hookButton(d, function(v) backHeld = v end) end
        end
    end
end

findAndHookCarButtons()
RunService.Heartbeat:Connect(findAndHookCarButtons)

--------------------------------------------------------------------
-- Seat detection
--------------------------------------------------------------------
local currentCar = nil
local flipState  = nil

local function getCarFromSeat(seat)
    if not seat then return nil end
    local a = seat
    while a and a.Parent do
        a = a.Parent
        if a:IsA("Model") then return a end
    end
    return nil
end

local function getChassisPart(car)
    if not car then return nil end
    local preferred = { "Body", "Chassis", "CarBody", "Base", "Drive", "Hull" }
    for _, name in ipairs(preferred) do
        local p = car:FindFirstChild(name, true)
        if p and p:IsA("BasePart") then return p end
    end
    if car.PrimaryPart and car.PrimaryPart:IsA("BasePart") then
        return car.PrimaryPart
    end
    local biggest, biggestSize = nil, 0
    for _, d in ipairs(car:GetChildren()) do
        if d:IsA("BasePart") then
            local s = d.Size.X * d.Size.Y * d.Size.Z
            if s > biggestSize then biggest, biggestSize = d, s end
        end
    end
    return biggest
end

local function onSeated(seat)
    currentCar = getCarFromSeat(seat)
    flipState = nil
    if currentCar then
        status.Text = currentCar.Name
        status.TextColor3 = COL_GREEN
        local chassis = getChassisPart(currentCar)
        info.Text = chassis and ("chassis  " .. chassis.Name) or "chassis not found"
    else
        status.Text = "Seated, no car found"
        status.TextColor3 = Color3.fromRGB(230, 190, 90)
        info.Text = ""
    end
end

local function onUnseated()
    stopThrust()
    currentCar = nil
    flipState = nil
    status.Text = "Waiting for vehicle..."
    status.TextColor3 = COL_TEXT_DIM
    info.Text = ""
end

local function bindCharacter(char)
    local humanoid = char:WaitForChild("Humanoid", 5)
    if not humanoid then return end
    humanoid.Seated:Connect(function(isSeated, seat)
        if isSeated then onSeated(seat) else onUnseated() end
    end)
    if humanoid.SeatPart then onSeated(humanoid.SeatPart) end
end

if player.Character then bindCharacter(player.Character) end
player.CharacterAdded:Connect(bindCharacter)

--------------------------------------------------------------------
-- Throttle value finder
--------------------------------------------------------------------
local cachedThrottle = nil
local function findThrottleValue()
    if cachedThrottle and cachedThrottle.Parent then return cachedThrottle end
    local pg = player:FindFirstChild("PlayerGui")
    if not pg then return nil end

    local aci = pg:FindFirstChild("A-Chassis Interface")
    if aci then
        local values = aci:FindFirstChild("Values")
        if values then
            local vel = values:FindFirstChild("Velocity")
            if vel and vel:IsA("Vector3Value") then
                cachedThrottle = vel
                return vel
            end
        end
    end

    for _, d in ipairs(pg:GetDescendants()) do
        if d:IsA("Vector3Value") and d.Name:lower() == "velocity" then
            cachedThrottle = d
            return d
        end
    end
    return nil
end

--------------------------------------------------------------------
-- Thrust loop
--------------------------------------------------------------------
local activeForce  = nil
local activeAttach = nil
local forceConn    = nil
local enabled      = false
local currentThrust = DEFAULT_THRUST

local function stopThrust()
    if forceConn then forceConn:Disconnect() forceConn = nil end
    if activeForce then pcall(function() activeForce:Destroy() end) activeForce = nil end
    if activeAttach then pcall(function() activeAttach:Destroy() end) activeAttach = nil end
end

local function ensureForceObjects(chassis)
    if activeForce and activeForce.Parent == chassis then return end
    if activeForce then pcall(function() activeForce:Destroy() end) end
    if activeAttach then pcall(function() activeAttach:Destroy() end) end
    activeAttach = Instance.new("Attachment")
    activeAttach.Name = "_NZAttach"
    activeAttach.Parent = chassis

    activeForce = Instance.new("VectorForce")
    activeForce.Name = "_NZForce"
    activeForce.Attachment0 = activeAttach
    activeForce.RelativeTo = Enum.ActuatorRelativeTo.World
    activeForce.ApplyAtCenterOfMass = true
    activeForce.Force = Vector3.zero
    activeForce.Parent = chassis
end

local function startLoop()
    if forceConn then forceConn:Disconnect() forceConn = nil end

    forceConn = RunService.Heartbeat:Connect(function()
        if not enabled then return end
        if not currentCar or not currentCar.Parent then return end

        local chassis = getChassisPart(currentCar)
        if not chassis then return end
        ensureForceObjects(chassis)

        if not forwardHeld or backHeld then
            if activeForce then activeForce.Force = Vector3.zero end
            return
        end

        local facing = chassis.CFrame.LookVector
        local flat = Vector3.new(facing.X, 0, facing.Z)
        if flat.Magnitude < 0.01 then
            activeForce.Force = Vector3.zero
            return
        end

        if flipState == nil then
            local tVal = findThrottleValue()
            if tVal then
                local t = tVal.Value
                local flatT = Vector3.new(t.X, 0, t.Z)
                if flatT.Magnitude > 0.01 then
                    local worldDir = (chassis.CFrame:VectorToWorldSpace(flatT)).Unit
                    flipState = worldDir:Dot(flat.Unit) < 0
                end
            end
        end
        if flipState == nil then
            local v = chassis.AssemblyLinearVelocity
            local vFlat = Vector3.new(v.X, 0, v.Z)
            if vFlat.Magnitude > 5 then
                flipState = vFlat.Unit:Dot(flat.Unit) < 0
            end
        end
        if flipState == true then flat = -flat end
        flat = flat.Unit

        local speed = chassis.AssemblyLinearVelocity.Magnitude
        local capFactor = 1
        if speed > MAX_SPEED_SOFT then
            capFactor = math.clamp(1 - (speed - MAX_SPEED_SOFT) / 100, 0, 1)
        end

        local strength = currentThrust * capFactor
        if speed < MIN_SPEED then strength = currentThrust * 0.5 end

        activeForce.Force = flat * strength
    end)
end

