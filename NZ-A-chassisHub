local function updateInputLabel()
    if state.forwardHeld and state.backHeld then
        inputState.Text = "Input  forward + back"
        inputState.TextColor3 = Color3.fromRGB(230, 200, 120)
    elseif state.forwardHeld then
        inputState.Text = "Input  forward"
        inputState.TextColor3 = COL_GREEN
    elseif state.backHeld then
        inputState.Text = "Input  backward"
        inputState.TextColor3 = Color3.fromRGB(230, 150, 120)
    else
        inputState.Text = "Input  -"
        inputState.TextColor3 = COL_TEXT_DIM
    end
end

UserInputService.InputBegan:Connect(function(input, gp)
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    if input.KeyCode == KEY_FORWARD then state.forwardHeld = true; updateInputLabel()
    elseif input.KeyCode == KEY_BACK then state.backHeld = true; updateInputLabel() end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    if input.KeyCode == KEY_FORWARD then state.forwardHeld = false; updateInputLabel()
    elseif input.KeyCode == KEY_BACK then state.backHeld = false; updateInputLabel() end
end)

local hookedButtons = {}
local function hookButton(btn, setter)
    if not btn or hookedButtons[btn] then return end
    hookedButtons[btn] = true
    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            setter(true); updateInputLabel()
        end
    end)
    btn.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            setter(false); updateInputLabel()
        end
    end)
    btn.MouseButton1Down:Connect(function() setter(true); updateInputLabel() end)
    btn.MouseButton1Up:Connect(function() setter(false); updateInputLabel() end)
end

local function findAndHookCarButtons()
    local pg = player:FindFirstChild("PlayerGui")
    if not pg then return end
    local aci = pg:FindFirstChild("A-Chassis Interface")
    if aci then
        local gauges = aci:FindFirstChild("Gauges")
        local guiFolder = gauges and gauges:FindFirstChild("GUI")
        if guiFolder then
            local ft = guiFolder:FindFirstChild("FullThrottle")
            local fb = guiFolder:FindFirstChild("FullBrake")
            if ft then hookButton(ft, function(v) state.forwardHeld = v end) end
            if fb then hookButton(fb, function(v) state.backHeld = v end) end
        end
        return
    end
    for _, d in ipairs(pg:GetDescendants()) do
        if d:IsA("TextButton") or d:IsA("ImageButton") then
            if d.Name == "FullThrottle" then hookButton(d, function(v) state.forwardHeld = v end)
            elseif d.Name == "FullBrake" then hookButton(d, function(v) state.backHeld = v end) end
        end
    end
