local sitActive    = false
local sitTarget    = nil
local sitReturnPos = nil
local sitConn      = nil
local sitAnimTrack = nil
local sitAnimObj   = nil

local function stopSit()
    if sitConn then sitConn:Disconnect() sitConn = nil end
    if not sitActive then return end

    local char = player.Character

    if sitAnimTrack then
        pcall(function() sitAnimTrack:Stop(0.1) end)
        sitAnimTrack = nil
    end
    if sitAnimObj then
        pcall(function() sitAnimObj:Destroy() end)
        sitAnimObj = nil
    end

    if char then
        for _, c in ipairs(char:GetDescendants()) do
            if c:IsA("WeldConstraint") and c.Name == "_NZSitWeld" then
                pcall(function() c:Destroy() end)
            end
        end

        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            pcall(function() hum.Sit = false end)
            pcall(function() hum.PlatformStand = false end)
            pcall(function() hum:ChangeState(Enum.HumanoidStateType.Running) end)
            pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
        end

        local root = char:FindFirstChild("HumanoidRootPart")
        if root and root.Parent then
            local upNudge = Vector3.new(0, 2, 0)
            pcall(function()
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
                if sitReturnPos then
                    root.CFrame = sitReturnPos + upNudge
                end
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
            end)

            task.defer(function()
                local c2 = player.Character
                local r2 = c2 and c2:FindFirstChild("HumanoidRootPart")
                if r2 and r2.Parent then
                    pcall(function()
                        r2.AssemblyLinearVelocity = Vector3.zero
                        r2.AssemblyAngularVelocity = Vector3.zero
                        if sitReturnPos then
                            r2.CFrame = sitReturnPos + upNudge
                        end
                    end)
                end
            end)
        end
    end

    sitActive = false
    sitTarget = nil
    sitReturnPos = nil

    if info and info.Parent then
        info.Text = "Stood up"
        info.TextColor3 = COL_YELLOW
        task.delay(1.0, function()
            if info and info.Parent then
                info.Text = state.currentBody and ("chassis  " .. state.currentBody.Name) or ""
                info.TextColor3 = COL_TEXT_DIM
            end
        end)
    end

    TweenService:Create(stopSitBtn, TweenInfo.new(0.18), {
        BackgroundColor3 = COL_BG_ALT, TextColor3 = COL_TEXT_DIM
    }):Play()
    TweenService:Create(sitBtn, TweenInfo.new(0.18), {
        BackgroundColor3 = COL_BG_ALT, TextColor3 = COL_TEXT_DIM
    }):Play()
    sitBtn.Text = "Sit: Off"
end
_G.__NZSitStop = stopSit

local function startSit(car)
    if sitActive then return end

    local char, root = getRoot()
    if not char or not root then return end

    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    sitReturnPos = root.CFrame

    local carCenter, carSize = getCarBounds(car)
    if not carCenter or not carSize then return end

    local chassis = getChassisPart(car)
    if not chassis then return end

    local forward = chassis.CFrame.LookVector
    forward = Vector3.new(forward.X, 0, forward.Z)
    if forward.Magnitude < 0.01 then
        forward = Vector3.new(0, 0, -1)
    end
    forward = forward.Unit

    local hoodPos = carCenter
        + forward * (carSize.Z * 0.35)
        + Vector3.new(0, carSize.Y * 0.35, 0)

    hum.Sit = false
    hum.PlatformStand = true

    pcall(function()
        root.CFrame = CFrame.new(hoodPos, hoodPos + forward)
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end)

    local weld = Instance.new("WeldConstraint")
    weld.Name = "_NZSitWeld"
    weld.Part0 = root
    weld.Part1 = chassis
    weld.Parent = root

    local rigType = getRigType(char)
    local animId = (rigType == "R6") and SIT_ANIM_R6 or SIT_ANIM_R15

    sitAnimObj = Instance.new("Animation")
    sitAnimObj.AnimationId = animId

    sitAnimTrack = hum:LoadAnimation(sitAnimObj)
    if sitAnimTrack then
        pcall(function()
            sitAnimTrack.Looped = true
            sitAnimTrack:Play(0.1)
        end)
    end

    sitActive = true
    sitTarget = car

    if info and info.Parent then
        info.Text = "Sat on " .. car.Name .. " (" .. rigType .. ")"
        info.TextColor3 = COL_GREEN
    end

    sitBtn.Text = "Sit: On"
    TweenService:Create(sitBtn, TweenInfo.new(0.18), {
        BackgroundColor3 = COL_GREEN, TextColor3 = Color3.fromRGB(255,255,255)
    }):Play()
    TweenService:Create(stopSitBtn, TweenInfo.new(0.18), {
        BackgroundColor3 = COL_RED, TextColor3 = Color3.fromRGB(255,255,255)
    }):Play()

    if sitConn then sitConn:Disconnect() end
    sitConn = RunService.Heartbeat:Connect(function()
        if not sitActive then return end
        if not sitTarget or not sitTarget.Parent then
            stopSit() return
        end
        local char2, root2 = getRoot()
        if not char2 or not root2 or not root2.Parent then
            stopSit() return
        end

        local chas2 = getChassisPart(sitTarget)
        if not chas2 then stopSit() return end

        local weld2 = root2:FindFirstChild("_NZSitWeld")
        if not weld2 then
            local w = Instance.new("WeldConstraint")
            w.Name = "_NZSitWeld"
            w.Part0 = root2
            w.Part1 = chas2
            w.Parent = root2
        end

        if not sitAnimTrack or not sitAnimTrack.IsPlaying then
            local hum2 = char2:FindFirstChildOfClass("Humanoid")
            if hum2 and sitAnimObj then
                local ok, track = pcall(function() return hum2:LoadAnimation(sitAnimObj) end)
                if ok and track then
                    sitAnimTrack = track
                    pcall(function()
                        sitAnimTrack.Looped = true
                        sitAnimTrack:Play(0.1)
                    end)
                end
            end
        end
    end)
end

