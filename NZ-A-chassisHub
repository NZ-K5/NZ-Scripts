local flingEnabled = false
local flingMode = "click"
local flingLast = 0
local flingBusy = false
local holdActive = false
local holdTarget = nil
local holdReturnPos = nil
local holdConn = nil

local function isCarModel(model)
    if not model:IsA("Model") then return false end
    local parts = 0
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("BasePart") then
            parts = parts + 1
            if parts >= 3 then break end
        end
    end
    if parts < 3 then return false end
    local names = { "Body", "Chassis", "CarBody", "Base", "Drive", "Hull" }
    for _, n in ipairs(names) do
        local p = model:FindFirstChild(n, true)
        if p and p:IsA("BasePart") then return true end
    end
    return false
end

local function findCarModel(instance)
    local node = instance
    while node and node.Parent and node ~= Workspace do
        if node:IsA("Model") and isCarModel(node) then return node end
        node = node.Parent
    end
    return nil
end

local function getRoot()
    local char = player.Character
    if not char then return nil, nil end
    return char, char:FindFirstChild("HumanoidRootPart")
end

local function applyMassKick(car, direction, verticalOnly)
    if not car then return end
    local mass = getCarMass(car)
    if not mass or mass <= 0 then mass = 1000 end
    local scale = mass / 1000
    local hKick = math.min(FLING_KICK_H_PER_KG * scale, FLING_MAX_KICK_H)
    local vKick = math.min(FLING_KICK_V_PER_KG * scale, FLING_MAX_KICK_V)
    local impulse
    if verticalOnly then
        impulse = Vector3.new(0, vKick, 0)
    else
        impulse = direction * hKick + Vector3.new(0, vKick, 0)
    end
    local chassis = getChassisPart(car)
    if not chassis then return end
    pcall(function()
        chassis.AssemblyLinearVelocity = chassis.AssemblyLinearVelocity + impulse
    end)
end

local function doClickFling(car)
    if flingBusy then return end
    local now = os.clock()
    if now - flingLast < FLING_COOLDOWN then return end
    flingLast = now
    local carCenter = getCarCenter(car)
    if not carCenter then return end
    local char, root = getRoot()
    if not char or not root then return end
    flingBusy = true
    local ok, err = pcall(function()
        local origCFrame = root.CFrame
        local camPos = camera.CFrame.Position
        local toCar = Vector3.new(carCenter.X - camPos.X, 0, carCenter.Z - camPos.Z)
        if toCar.Magnitude < 0.01 then toCar = Vector3.new(0, 0, -1) else toCar = toCar.Unit end
        local pushPos = carCenter + toCar * FLING_OVERLAP
        pushPos = Vector3.new(pushPos.X, carCenter.Y + FLING_UP_OFFSET, pushPos.Z)
        pcall(function() root.CFrame = CFrame.new(pushPos, pushPos + toCar) end)
        local chassis = getChassisPart(car)
        applyMassKick(car, toCar, false)
        local stopAt = os.clock() + FLING_PUSH_DUR
        local lockConn
        lockConn = RunService.Heartbeat:Connect(function()
            if os.clock() >= stopAt or not root or not root.Parent then
                if lockConn then lockConn:Disconnect() end
                return
            end
            pcall(function()
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
                root.CFrame = CFrame.new(pushPos, pushPos + toCar)
            end)
            if chassis and chassis.Parent then
                local mass = getCarMass(car)
                local scale = math.max(mass, 1) / 1000
                local contKick = math.min(FLING_KICK_H_PER_KG * scale * 0.15, FLING_MAX_KICK_H * 0.2)
                pcall(function()
                    chassis.AssemblyLinearVelocity = chassis.AssemblyLinearVelocity + toCar * contKick
                end)
            end
        end)
        task.delay(FLING_PUSH_DUR + FLING_RETURN, function()
            if lockConn then pcall(function() lockConn:Disconnect() end) end
            local char2, root2 = getRoot()
            if root2 and root2.Parent then
                pcall(function()
                    root2.CFrame = origCFrame
                    root2.AssemblyLinearVelocity = Vector3.zero
                    root2.AssemblyAngularVelocity = Vector3.zero
                end)
            end
            flingBusy = false
        end)
        local m = getCarMass(car)
        info.Text = string.format("Flung %s (~%d mass)", car.Name, math.floor(m))
        info.TextColor3 = COL_GREEN
        task.delay(1.4, function()
            if info and info.Parent then
                info.Text = state.currentBody and ("chassis  " .. state.currentBody.Name) or ""
                info.TextColor3 = COL_TEXT_DIM
            end
        end)
    end)
    if not ok then
        flingBusy = false
        warn("doClickFling error:", err)
    end
end

local function stopHoldFling()
    if holdConn then holdConn:Disconnect() holdConn = nil end
    local char, root = getRoot()
    if root and root.Parent and holdReturnPos then
        pcall(function()
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            root.CFrame = holdReturnPos
        end)
    end
    holdActive = false
    holdTarget = nil
    holdReturnPos = nil
    if info and info.Parent then
        info.Text = "Released · snapped back"
        info.TextColor3 = COL_YELLOW
        task.delay(1.0, function()
            if info and info.Parent then
                info.Text = state.currentBody and ("chassis  " .. state.currentBody.Name) or ""
                info.TextColor3 = COL_TEXT_DIM
            end
        end)
    end
end
_G.__NZHoldFlingStop = stopHoldFling

local function startHoldFling(car)
    if holdActive then return end
    local char, root = getRoot()
    if not char or not root then return end
    if not getChassisPart(car) then return end
    holdActive = true
    holdTarget = car
    holdReturnPos = root.CFrame
    if holdConn then holdConn:Disconnect() end
    holdConn = RunService.Heartbeat:Connect(function(dt)
        if not holdActive then return end
        if not holdTarget or not holdTarget.Parent then stopHoldFling() return end
        local _, r = getRoot()
        if not r or not r.Parent then stopHoldFling() return end
        local carCenter = getCarCenter(holdTarget)
        if not carCenter then stopHoldFling() return end
        local t = os.clock()
        local spinCFrame = CFrame.new(carCenter + Vector3.new(0, 2, 0))
            * CFrame.Angles(t * HOLD_SPIN_SPEED * 0.1,
                            t * HOLD_SPIN_SPEED * 0.13,
                            t * HOLD_SPIN_SPEED * 0.17)
        pcall(function()
            r.CFrame = spinCFrame
            r.AssemblyLinearVelocity = Vector3.zero
            r.AssemblyAngularVelocity = Vector3.zero
        end)
        local chas = getChassisPart(holdTarget)
        if chas then
            local camPos = camera.CFrame.Position
            local dir = Vector3.new(carCenter.X - camPos.X, 0, carCenter.Z - camPos.Z)
            if dir.Magnitude > 0.01 then
                dir = dir.Unit
                local mass = getCarMass(holdTarget)
                local scale = math.max(mass, 1) / 1000
                local pushAmount = math.min(HOLD_PUSH_PER_KG * scale, 250)
                pcall(function()
                    chas.AssemblyLinearVelocity = chas.AssemblyLinearVelocity + dir * pushAmount
                end)
            end
        end
    end)
    if info and info.Parent then
        local m = getCarMass(car)
        info.Text = string.format("Hold-flinging %s (~%d mass)", car.Name, math.floor(m))
        info.TextColor3 = COL_GREEN
    end
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not flingEnabled then return end
    if gameProcessed or isAnyTextBoxFocused() then return end
    local isClick = input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch
    if not isClick then return end
    local pos = input.Position
    local ray = camera:ViewportPointToRay(pos.X, pos.Y)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { player.Character }
    local hit = Workspace:Raycast(ray.Origin, ray.Direction * 5000, params)
    if not hit then return end
    local car = findCarModel(hit.Instance)
    if not car then
        info.Text = "Not a car"
        info.TextColor3 = COL_RED
        task.delay(1.0, function()
            if info and info.Parent then
                info.Text = state.currentBody and ("chassis  " .. state.currentBody.Name) or ""
                info.TextColor3 = COL_TEXT_DIM
            end
        end)
        return
    end
    if flingMode == "click" then doClickFling(car) else startHoldFling(car) end
end)

UserInputService.InputEnded:Connect(function(input)
    if not flingEnabled then return end
    local isClick = input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch
    if not isClick then return end
    if flingMode == "hold" and holdActive then stopHoldFling() end
end)

