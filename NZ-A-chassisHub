local function saveCarState(chassis)
    local snap = {
        parts = {},
        cframe = chassis.CFrame,
        velocity = chassis.AssemblyLinearVelocity,
        angular  = chassis.AssemblyAngularVelocity,
    }
    local asmRoot = chassis.AssemblyRootPart or chassis
    for _, p in ipairs(asmRoot:GetConnectedParts(true)) do
        if p:IsA("BasePart") then snap.parts[p] = p.Anchored end
    end
    snap.parts[asmRoot] = asmRoot.Anchored
    return snap
end

local function restoreCarState(chassis, snap)
    if not snap then return end
    pcall(function()
        if chassis and chassis.Parent then
            chassis.CFrame = snap.cframe
        end
    end)
    for part, anchored in pairs(snap.parts) do
        pcall(function()
            if part and part.Parent then part.Anchored = anchored end
        end)
    end
    pcall(function()
        if chassis and chassis.Parent then
            chassis.AssemblyLinearVelocity = snap.velocity
            chassis.AssemblyAngularVelocity = snap.angular
        end
    end)
end

local function destroyHoverObjects()
    if hoverForce then pcall(function() hoverForce:Destroy() end) hoverForce = nil end
    if hoverAttach then pcall(function() hoverAttach:Destroy() end) hoverAttach = nil end
end

local function stopFly()
    if flyConn then flyConn:Disconnect() flyConn = nil end
    destroyHoverObjects()
    if not flyActive then return end
    flyActive = false
    _G.__NZFlyActive = false
    for k in pairs(_G.__NZFlyHold) do _G.__NZFlyHold[k] = false end
    if state.currentCar then
        local chassis = getChassisPart(state.currentCar)
        if chassis then restoreCarState(chassis, savedState) end
    end
    savedState = nil
end
_G.__NZFlyStop = stopFly

local function startFly()
    if flyActive then return end
    if not state.currentCar then return end
    local chassis = getChassisPart(state.currentCar)
    if not chassis then return end

    flyActive = true
    _G.__NZFlyActive = true
    savedState = saveCarState(chassis)

    destroyHoverObjects()
    hoverAttach = Instance.new("Attachment")
    hoverAttach.Name = "_NZHoverAttach"
    hoverAttach.Parent = chassis

    hoverForce = Instance.new("VectorForce")
    hoverForce.Name = "_NZHoverForce"
    hoverForce.Attachment0 = hoverAttach
    hoverForce.RelativeTo = Enum.ActuatorRelativeTo.World
    hoverForce.ApplyAtCenterOfMass = true
    hoverForce.Force = Vector3.zero
    hoverForce.Parent = chassis

    if flyConn then flyConn:Disconnect() end
    flyConn = RunService.Heartbeat:Connect(function(dt)
        if not flyActive then return end
        if not state.currentCar or not state.currentCar.Parent then
            stopFly() return
        end
        local chas = getChassisPart(state.currentCar)
        if not chas then stopFly() return end

        -- Rebuild hover objects if lost
        if not hoverForce or hoverForce.Parent ~= chas then
            destroyHoverObjects()
            hoverAttach = Instance.new("Attachment")
            hoverAttach.Name = "_NZHoverAttach"
            hoverAttach.Parent = chas
            hoverForce = Instance.new("VectorForce")
            hoverForce.Name = "_NZHoverForce"
            hoverForce.Attachment0 = hoverAttach
            hoverForce.RelativeTo = Enum.ActuatorRelativeTo.World
            hoverForce.ApplyAtCenterOfMass = true
            hoverForce.Force = Vector3.zero
            hoverForce.Parent = chas
        end

        local hold = _G.__NZFlyHold
        local pressingVert = hold.up or hold.down

        if not pressingVert then
            -- Hover: cancel gravity exactly
            local mass = chas:GetMass()
            local g = Workspace.Gravity
            hoverForce.Force = Vector3.new(0, mass * g, 0)
            -- Zero vertical velocity to fully stabilize
            local v = chas.AssemblyLinearVelocity
            chas.AssemblyLinearVelocity = Vector3.new(v.X, 0, v.Z)
        else
            -- User is driving vertically. No hover force.
            hoverForce.Force = Vector3.zero
            -- Only cancel horizontal velocity (so buttons feel snappy)
            local v = chas.AssemblyLinearVelocity
            chas.AssemblyLinearVelocity = Vector3.new(0, v.Y, 0)
        end

        chas.AssemblyAngularVelocity = Vector3.zero

        -- Movement: buttons → CFrame step
        local move = Vector3.zero
        if hold.forward then move = move + Vector3.new(0, 0, -1) end
        if hold.back    then move = move + Vector3.new(0, 0, 1) end
        if hold.right   then move = move + Vector3.new(1, 0, 0) end
        if hold.left    then move = move - Vector3.new(1, 0, 0) end
        if hold.up      then move = move + Vector3.new(0, 1, 0) end
        if hold.down    then move = move - Vector3.new(0, 1, 0) end

        if move.Magnitude > 0 then
            local horiz = Vector3.new(move.X, 0, move.Z)
            local vert  = move.Y
            local step  = Vector3.zero
            if horiz.Magnitude > 0.01 then
                step = step + horiz.Unit * FLY_SPEED * dt
            end
            step = step + Vector3.new(0, vert * FLY_VERT_SPEED * dt, 0)
            chas.CFrame = chas.CFrame + step
        end
    end)
end

