local flyConn    = nil
local flyActive  = false
local savedState = nil

local function collectCarParts(chassis)
    local car = chassis
    while car and car.Parent and not car:IsA("Model") do
        car = car.Parent
    end
    if not car then return { chassis } end
    local parts = {}
    for _, d in ipairs(car:GetDescendants()) do
        if d:IsA("BasePart") then table.insert(parts, d) end
    end
    if not table.find(parts, chassis) then table.insert(parts, chassis) end
    return parts
end

local function saveFlyState(chassis)
    local parts = collectCarParts(chassis)
    local anchored = {}
    local cframes = {}
    for _, p in ipairs(parts) do
        anchored[p] = p.Anchored
        cframes[p] = p.CFrame
    end
    return {
        parts    = parts,
        anchored = anchored,
        cframes  = cframes,
        velocity = chassis.AssemblyLinearVelocity,
        angular  = chassis.AssemblyAngularVelocity,
    }
end

local function restoreFlyState(chassis, snap)
    if not snap then return end
    for _, p in ipairs(snap.parts) do
        pcall(function()
            if p and p.Parent then
                p.CFrame = snap.cframes[p]
                p.Anchored = snap.anchored[p]
            end
        end)
    end
    pcall(function()
        if chassis and chassis.Parent then
            chassis.AssemblyLinearVelocity = snap.velocity
            chassis.AssemblyAngularVelocity = snap.angular
        end
    end)
end

local function stopFly()
    if flyConn then flyConn:Disconnect() flyConn = nil end
    if not flyActive then return end
    flyActive = false
    _G.__NZFlyActive = false
    for k in pairs(_G.__NZFlyHold) do _G.__NZFlyHold[k] = false end
    if state.currentCar then
        local chassis = getChassisPart(state.currentCar)
        if chassis then restoreFlyState(chassis, savedState) end
    end
    savedState = nil
end
_G.__NZFlyStop = stopFly

-- PC keyboard state for fly
local flyKeys = {
    [KEY_FORWARD] = "forward",
    [KEY_BACK]    = "back",
    [KEY_LEFT]    = "left",
    [KEY_RIGHT]   = "right",
    [KEY_UP]      = "up",
    [KEY_DOWN]    = "down",
}

UserInputService.InputBegan:Connect(function(input, gp)
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    if not flyActive then return end
    local key = flyKeys[input.KeyCode]
    if key then _G.__NZFlyHold[key] = true end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    local key = flyKeys[input.KeyCode]
    if key then _G.__NZFlyHold[key] = false end
end)

local function startFly()
    if flyActive then return end
    if not state.currentCar then return end
    local chassis = getChassisPart(state.currentCar)
    if not chassis then return end

    flyActive = true
    _G.__NZFlyActive = true
    savedState = saveFlyState(chassis)

    for _, p in ipairs(savedState.parts) do
        pcall(function() p.Anchored = true end)
    end
    pcall(function()
        chassis.AssemblyLinearVelocity = Vector3.zero
        chassis.AssemblyAngularVelocity = Vector3.zero
    end)

    if flyConn then flyConn:Disconnect() end
    flyConn = RunService.Heartbeat:Connect(function(dt)
        if not flyActive then return end
        if not state.currentCar or not state.currentCar.Parent then
            stopFly() return
        end
        local chas = getChassisPart(state.currentCar)
        if not chas then stopFly() return end

        local hold = _G.__NZFlyHold
        local move = Vector3.zero
        if hold.forward then move = move + Vector3.new(0, 0, -1) end
        if hold.back    then move = move + Vector3.new(0, 0, 1) end
        if hold.right   then move = move + Vector3.new(1, 0, 0) end
        if hold.left    then move = move - Vector3.new(1, 0, 0) end
        if hold.up      then move = move + Vector3.new(0, 1, 0) end
        if hold.down    then move = move - Vector3.new(0, 1, 0) end

        if move.Magnitude < 0.001 then return end

        local horiz = Vector3.new(move.X, 0, move.Z)
        local vert  = move.Y
        local step  = Vector3.zero
        if horiz.Magnitude > 0.01 then
            step = step + horiz.Unit * currentFlySpeed * dt
        end
        step = step + Vector3.new(0, vert * currentFlyVertSpeed * dt, 0)

        if step.Magnitude < 1e-6 then return end

        for _, p in ipairs(savedState.parts) do
            if p and p.Parent then
                p.CFrame = p.CFrame + step
            end
        end
    end)
end

