-- HELPERS
--------------------------------------------------------------------
local function getCarFromSeat(seat)
    if not seat then return nil end
    local a = seat
    while a and a.Parent do
        a = a.Parent
        if a:IsA("Model") then return a end
    end
    return nil
end

local function getChassisPart(car)
    if not car then return nil end
    local preferred = { "Body", "Chassis", "CarBody", "Base", "Drive", "Hull" }
    for _, name in ipairs(preferred) do
        local p = car:FindFirstChild(name, true)
        if p and p:IsA("BasePart") then return p end
    end
    if car.PrimaryPart and car.PrimaryPart:IsA("BasePart") then
        return car.PrimaryPart
    end
    local biggest, biggestSize = nil, 0
    for _, d in ipairs(car:GetChildren()) do
        if d:IsA("BasePart") then
            local s = d.Size.X * d.Size.Y * d.Size.Z
            if s > biggestSize then biggest, biggestSize = d, s end
        end
    end
    return biggest
end

local function getCarCenter(car)
    if not car then return nil end
    local min, max = nil, nil
    for _, d in ipairs(car:GetDescendants()) do
        if d:IsA("BasePart") then
            local pos = d.Position
            local half = d.Size * 0.5
            local low  = pos - half
            local high = pos + half
            if not min then
                min = low; max = high
            else
                min = Vector3.new(math.min(min.X, low.X), math.min(min.Y, low.Y), math.min(min.Z, low.Z))
                max = Vector3.new(math.max(max.X, high.X), math.max(max.Y, high.Y), math.max(max.Z, high.Z))
            end
        end
    end
    if not min then return nil end
    return (min + max) * 0.5
end

local function getCarBounds(car)
    if not car then return nil, nil end
    local min, max = nil, nil
    for _, d in ipairs(car:GetDescendants()) do
        if d:IsA("BasePart") then
            local pos = d.Position
            local half = d.Size * 0.5
            local low  = pos - half
            local high = pos + half
            if not min then
                min = low; max = high
            else
                min = Vector3.new(math.min(min.X, low.X), math.min(min.Y, low.Y), math.min(min.Z, low.Z))
                max = Vector3.new(math.max(max.X, high.X), math.max(max.Y, high.Y), math.max(max.Z, high.Z))
            end
        end
    end
    if not min then return nil, nil end
    return (min + max) * 0.5, max - min
end

local function getCarMass(car)
    local chassis = getChassisPart(car)
    if not chassis then return 0 end
    local ok, mass = pcall(function()
        local asmRoot = chassis.AssemblyRootPart or chassis
        return asmRoot.AssemblyMass
    end)
    if ok and mass and mass > 0 then return mass end
    local total = 0
    for _, d in ipairs(car:GetDescendants()) do
        if d:IsA("BasePart") then
            total = total + d:GetMass()
        end
    end
    return total
end

local function findThrottleValue()
    local pg = player:FindFirstChild("PlayerGui")
    if not pg then return nil end
    local aci = pg:FindFirstChild("A-Chassis Interface")
    if aci then
        local values = aci:FindFirstChild("Values")
        if values then
            local vel = values:FindFirstChild("Velocity")
            if vel and vel:IsA("Vector3Value") then return vel end
        end
    end
    return nil
end

local function getRigType(char)
    if not char then return "R15" end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        if hum.RigType == Enum.HumanoidRigType.R6 then return "R6"
        elseif hum.RigType == Enum.HumanoidRigType.R15 then return "R15" end
    end
    if char:FindFirstChild("Torso") and not char:FindFirstChild("UpperTorso") then
        return "R6"
    end
    return "R15"
end

