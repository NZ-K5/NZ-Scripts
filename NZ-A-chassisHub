    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = titleBar

    local delBtn = Instance.new("TextButton")
    delBtn.Size = UDim2.new(0, 24, 0, 24)
    delBtn.Position = UDim2.new(1, -60, 0.5, -12)
    delBtn.BackgroundColor3 = Color3.fromRGB(38, 39, 48)
    delBtn.Text = "X"
    delBtn.TextColor3 = COL_TEXT_DIM
    delBtn.Font = Enum.Font.GothamBold
    delBtn.TextSize = 13
    delBtn.BorderSizePixel = 0
    delBtn.AutoButtonColor = false
    delBtn.Parent = titleBar
    corner(delBtn, 6)

    local minBtn = Instance.new("TextButton")
    minBtn.Size = UDim2.new(0, 24, 0, 24)
    minBtn.Position = UDim2.new(1, -32, 0.5, -12)
    minBtn.BackgroundColor3 = Color3.fromRGB(38, 39, 48)
    minBtn.Text = "-"
    minBtn.TextColor3 = COL_TEXT_DIM
    minBtn.Font = Enum.Font.GothamBold
    minBtn.TextSize = 16
    minBtn.BorderSizePixel = 0
    minBtn.AutoButtonColor = false
    minBtn.Parent = titleBar
    corner(minBtn, 6)

    local dragging, dragInput, dragStart, startPos

    local function clampParent()
        local vp = camera.ViewportSize
        local abs = parent.AbsolutePosition
        local size = parent.AbsoluteSize
        local minX = -(size.X - 60)
        local maxX = vp.X - 60
        local minY = 0
        local maxY = vp.Y - 50
        local newX = math.clamp(abs.X, minX, maxX)
        local newY = math.clamp(abs.Y, minY, maxY)
        if newX ~= abs.X or newY ~= abs.Y then
            parent.Position = UDim2.new(0, newX, 0, newY)
        end
    end

    titleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = parent.Position
        end
    end)
    titleBar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            parent.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            if dragging then
                dragging = false
                clampParent()
            end
        end
    end)

    delBtn.MouseButton1Click:Connect(function()
        if onDelete then onDelete() end
        parent:Destroy()
    end)

    return titleBar, minBtn
end

