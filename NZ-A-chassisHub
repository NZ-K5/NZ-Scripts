local function onSeated(seat)
    state.currentCar = getCarFromSeat(seat)
    state.flipState = nil
    state.currentBody = nil
    if state.currentCar then
        status.Text = state.currentCar.Name
        status.TextColor3 = COL_GREEN
        local chassis = getChassisPart(state.currentCar)
        state.currentBody = chassis
        info.Text = chassis and ("chassis  " .. chassis.Name) or "chassis not found"
    else
        status.Text = "Seated, no car found"
        status.TextColor3 = Color3.fromRGB(230, 190, 90)
        info.Text = ""
    end
    findAndHookCarButtons()
end

local function onUnseated()
    state.currentCar = nil
    state.currentBody = nil
    state.flipState = nil
    status.Text = "Waiting for vehicle..."
    status.TextColor3 = COL_TEXT_DIM
    info.Text = ""
    if _G.__NZFlyStop then _G.__NZFlyStop() end
end

local function bindCharacter(char)
    local humanoid = char:WaitForChild("Humanoid", 5)
    if not humanoid then return end
    humanoid.Seated:Connect(function(isSeated, seat)
        if isSeated then onSeated(seat) else onUnseated() end
    end)
    if humanoid.SeatPart then onSeated(humanoid.SeatPart) end
end

